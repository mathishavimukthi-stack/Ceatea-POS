{
  "name": "ceatea-pos",
  "version": "1.0.4",
  "description": "Ceatea Point of Sale — Desktop Edition",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ceatea.pos",
    "productName": "Ceatea POS",
    "copyright": "Copyright © 2025 Ceatea",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "ipc-handlers.js",
      "config.js",
      "supabase-client.js",
      "index.html",
      "assets/**",
      "node_modules/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "http://192.168.1.17:3000/updates"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ceatea POS"
    }
  }
}
